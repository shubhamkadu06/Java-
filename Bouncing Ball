import javax.swing.*;
import java.awt.*;
import java.awt.event.ActionEvent;
import java.awt.event.ActionListener;

public class BouncingBall extends JPanel implements ActionListener {
    // 1. Set up initial positions, size, and speeds
    private int x = 300;
    private int y = 200;
    private final int diameter = 40;
    private int speedX = 4;
    private int speedY = 3;

    // 2. Timer fires every 16 milliseconds (~60 FPS)
    private final Timer timer = new Timer(16, this);

    public BouncingBall() {
        setBackground(new Color(30, 30, 30)); // Dark gray background
        timer.start(); // Start the animation loop
    }

    // 3. Drawing Phase: Automatically called whenever repaint() runs
    @Override
    protected void paintComponent(Graphics g) {
        super.paintComponent(g);
        
        // Enable anti-aliasing for smooth circle edges
        Graphics2D g2d = (Graphics2D) g;
        g2d.setRenderingHint(RenderingHints.KEY_ANTIALIASING, RenderingHints.VALUE_ANTIALIAS_ON);

        // Draw orange ball
        g2d.setColor(new Color(255, 87, 34));
        g2d.fillOval(x, y, diameter, diameter);
    }

    // 4. Update Phase: Runs on every timer tick
    @Override
    public void actionPerformed(ActionEvent e) {
        // Move the object's coordinates
        x += speedX;
        y += speedY;

        // Boundary collisions: Reverse direction when hitting window edges
        if (x <= 0 || x + diameter >= getWidth()) {
            speedX *= -1;
        }
        if (y <= 0 || y + diameter >= getHeight()) {
            speedY *= -1;
        }

        // Request the screen to redraw with updated coordinates
        repaint();
    }

    // 5. Main method to set up the application window
    public static void main(String[] args) {
        JFrame frame = new JFrame("Bouncing Ball Animation");
        BouncingBall animationPanel = new BouncingBall();

        frame.add(animationPanel);
        frame.setSize(640, 480);
        frame.setDefaultCloseOperation(JFrame.EXIT_ON_CLOSE);
        frame.setLocationRelativeTo(null); // Center window on screen
        frame.setVisible(true);
    }
}
